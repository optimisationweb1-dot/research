# copy to live/.env on the server (never commit, never send in chat)
BINGX_API_KEY=
BINGX_SECRET=
# permissions on BingX: read + perpetual futures trading; withdrawals OFF; IP whitelist = server IP
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RISK_PCT=0.25            # % of equity risked per trade
MAX_OPEN_RISK_PCT=3      # cap on total risk of all open positions
DD_HALT_PCT=15           # stop NEW entries if equity falls 15% below peak
LEVERAGE=3
HEDGE_MODE=0             # 1 if your BingX account is in hedge (dual-side) mode
PAPER_EQUITY=1000
LIVE_CONFIRM=NO          # set YES only when you really want real orders
# SYMBOLS=BTC ETH SOL XRP DOGE BNB ADA AVAX LINK LTC
